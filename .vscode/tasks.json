{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "start",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^.*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "compiled|compiling|webpack",
                    "endsPattern": "compiled successfully|successfully"
                }
            },
            "label": "npm: start"
        },
        {
            "type": "npm",
            "script": "deploy",
            "problemMatcher": [],
            "label": "npm: deploy"
        }
    ]
}
